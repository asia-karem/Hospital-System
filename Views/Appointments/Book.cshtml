
@model HospitalSystem.Models.Appointment

@{
    ViewData["Title"] = "Book Appointment";
    var doctor = ViewBag.Doctor as HospitalSystem.Models.Doctor;
}

<div class="booking-page">

    <div class="booking-container">

        <!-- Doctor Section -->
        <div class="doctor-preview">

            <div class="doctor-preview-image">

                @if (!string.IsNullOrEmpty(doctor.Image))
                {
                    <img src="~/images/doctors/@doctor.Image"
                         alt="Dr. @doctor.Name" />
                }
                else
                {
                    <div class="doctor-placeholder">
                        +
                    </div>
                }

                <span class="available-badge">
                    ● Available
                </span>

            </div>

            <div class="doctor-preview-info">

                <span class="small-title">
                    YOUR SELECTED DOCTOR
                </span>

                <h2>
                    Dr. @doctor.Name
                </h2>

                <p class="specialization">
                    @doctor.Specialization
                </p>

                <div class="doctor-status">
                    <span>✓</span>
                    Available for appointments
                </div>

            </div>

        </div>


        <!-- Booking Form -->
        <div class="booking-form">

            <div class="booking-header">

                <span class="small-title">
                    APPOINTMENT DETAILS
                </span>

                <h1>Book Your Appointment</h1>

                <p>
                    Please enter your information and select your
                    preferred date and time.
                </p>

            </div>


            <form asp-action="Book" method="post">

                <input type="hidden"
                       asp-for="DoctorId"
                       value="@doctor.Id" />


                <!-- Patient Name -->
                <div class="form-group">

                    <label class="booking-label">
                        Patient Name
                    </label>

                    <div class="input-wrapper">

                        <span class="input-icon">👤</span>

                        <input asp-for="PatientName"
                               class="booking-input"
                               placeholder="Enter your full name" />

                    </div>

                </div>


                <!-- Date -->
                <div class="form-group">

                    <label class="booking-label">
                        Appointment Date
                    </label>

                    <div class="input-wrapper">

                        <span class="input-icon">📅</span>

                        <input asp-for="Date"
                               type="date"
                               class="booking-input"
                               id="appointmentDate" />

                    </div>

                    <small class="input-hint">
                        Appointments are available Sunday to Thursday.
                    </small>

                </div>


                <!-- Time -->
                <div class="form-group">

                    <label class="booking-label">
                        Appointment Time
                    </label>

                    <div class="input-wrapper">

                        <span class="input-icon">◷</span>

                        <select asp-for="Time"
                                class="booking-input booking-select">

                            <option value="">
                                Select your preferred time
                            </option>

                            <option value="09:00:00">9:00 AM</option>
                            <option value="09:30:00">9:30 AM</option>

                            <option value="10:00:00">10:00 AM</option>
                            <option value="10:30:00">10:30 AM</option>

                            <option value="11:00:00">11:00 AM</option>
                            <option value="11:30:00">11:30 AM</option>

                            <option value="12:00:00">12:00 PM</option>
                            <option value="12:30:00">12:30 PM</option>

                            <option value="13:00:00">1:00 PM</option>
                            <option value="13:30:00">1:30 PM</option>

                            <option value="14:00:00">2:00 PM</option>
                            <option value="14:30:00">2:30 PM</option>

                            <option value="15:00:00">3:00 PM</option>
                            <option value="15:30:00">3:30 PM</option>

                            <option value="16:00:00">4:00 PM</option>
                            <option value="16:30:00">4:30 PM</option>

                        </select>

                    </div>

                </div>


                <!-- Submit -->
                <button type="submit"
                        class="premium-book-btn">

                    <span>Confirm Appointment</span>

                    <strong>→</strong>

                </button>

                <p class="secure-text">
                    ✓ Your appointment information is handled securely.
                </p>

            </form>

        </div>

    </div>

</div>


<script>

    document.getElementById("appointmentDate")
        .addEventListener("change", function () {

            var date = new Date(this.value);
            var day = date.getDay();

            // Friday = 5
            // Saturday = 6

            if (day === 5 || day === 6) {

                alert(
                    "Appointments are available only from Sunday to Thursday."
                );

                this.value = "";
            }

        });

</script>

