@model HospitalSystem.Models.Appointment

@{
    ViewData["Title"] = "Book Appointment";
    var doctor = ViewBag.Doctor as HospitalSystem.Models.Doctor;
}

<div class="container mt-4">

    <h2>Book Appointment</h2>

    <div class="card p-4">

        <h4>Doctor: Dr. @doctor.Name</h4>

        <p>Specialization: @doctor.Specialization</p>

        <form asp-action="Book" method="post">

            <input type="hidden"
                   asp-for="DoctorId"
                   value="@doctor.Id" />

            <div class="mb-3">
                <label>Patient Name</label>
                <input asp-for="PatientName"
                       class="form-control"
                       placeholder="Enter patient name" />
            </div>

            <div class="mb-3">
                <label>Date</label>
                <input asp-for="Date"
                       type="date"
                       class="form-control"
                       id="appointmentDate" />
            </div>

            <div class="mb-3">
                <label>Time</label>

                <select asp-for="Time" class="form-control">

                    <option value="">Select Time</option>

                    <option value="09:00:00">9:00 AM</option>
                    <option value="09:30:00">9:30 AM</option>

                    <option value="10:00:00">10:00 AM</option>
                    <option value="10:30:00">10:30 AM</option>

                    <option value="11:00:00">11:00 AM</option>
                    <option value="11:30:00">11:30 AM</option>

                    <option value="12:00:00">12:00 PM</option>
                    <option value="12:30:00">12:30 PM</option>

                    <option value="13:00:00">1:00 PM</option>
                    <option value="13:30:00">1:30 PM</option>

                    <option value="14:00:00">2:00 PM</option>
                    <option value="14:30:00">2:30 PM</option>

                    <option value="15:00:00">3:00 PM</option>
                    <option value="15:30:00">3:30 PM</option>

                    <option value="16:00:00">4:00 PM</option>
                    <option value="16:30:00">4:30 PM</option>

                </select>
            </div>

            <button type="submit"
                    class="btn btn-success">
                Book Appointment
            </button>

        </form>

    </div>

</div>

<script>
    document.getElementById("appointmentDate").addEventListener("change", function () {

        var date = new Date(this.value);
        var day = date.getDay();

        // Friday = 5
        // Saturday = 6

        if (day === 5 || day === 6) {
            alert("Appointments are available only from Sunday to Thursday.");
            this.value = "";
        }

    });
</script>