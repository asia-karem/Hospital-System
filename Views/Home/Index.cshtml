
@{
    ViewData["Title"] = "Hospital Appointment System";
}

<div class="home-page">

    <div class="hero-content">

        <div class="medical-logo">
            <span>+</span>
        </div>

        <p class="welcome-text">WELCOME TO OUR HOSPITAL</p>

        <h1>
            Hospital
            <span>Appointment System</span>
        </h1>

        <p class="hero-description">
            A simple and secure way to book your medical appointments
            and manage your visits with ease.
        </p>

        <div class="home-buttons">

            <a asp-controller="Doctors"
               asp-action="Index"
               class="hero-btn primary-btn">
                <span>Book an Appointment</span>
                <strong>→</strong>
            </a>

            <a asp-controller="Appointments"
               asp-action="Index"
               class="hero-btn secondary-btn">
                <span>View Appointments</span>
                <strong>→</strong>
            </a>

        </div>

        <div class="hero-features">
            <div>
                <strong>✓</strong>
                Easy Booking
            </div>

            <div>
                <strong>✓</strong>
                Trusted Doctors
            </div>

            <div>
                <strong>✓</strong>
                Simple Management
            </div>
        </div>

    </div>

</div>
