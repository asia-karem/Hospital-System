
@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="privacy-page">

    <div class="privacy-container">

        <div class="privacy-icon">
            🔒
        </div>

        <span class="privacy-label">
            YOUR PRIVACY MATTERS
        </span>

        <h1>Privacy Policy</h1>

        <p class="privacy-intro">
            Your privacy is important to us. This page explains how
            information is handled when using our Hospital Appointment System.
        </p>


        <div class="privacy-section">

            <h3>1. Information We Collect</h3>

            <p>
                When booking an appointment, we may collect basic information
                such as the patient's name, selected doctor, appointment date,
                and appointment time.
            </p>

        </div>


        <div class="privacy-section">

            <h3>2. How We Use Your Information</h3>

            <p>
                The information provided is used only to manage and organize
                hospital appointments and provide a better booking experience.
            </p>

        </div>


        <div class="privacy-section">

            <h3>3. Information Security</h3>

            <p>
                We take reasonable steps to keep appointment information
                secure and prevent unauthorized access.
            </p>

        </div>


        <div class="privacy-section">

            <h3>4. Your Privacy</h3>

            <p>
                We respect your privacy and do not use appointment information
                for purposes unrelated to the hospital appointment system.
            </p>

        </div>


        <div class="privacy-footer">

            <span>✓</span>

            Your information is handled with care and responsibility.

        </div>

    </div>

</div>

