```cshtml
@model List<HospitalSystem.Models.Doctor>

@{
    ViewData["Title"] = "Our Doctors";
}

<div class="doctors-page">

    <!-- Header -->
    <div class="doctors-header">

        <span class="section-label">OUR MEDICAL TEAM</span>

        <h1>Meet Our Doctors</h1>

        <p>
            Find the right doctor for your needs and book your appointment easily.
        </p>

    </div>


    <!-- Search & Filter -->
    <div class="container">

        <div class="search-box">

            <form method="get" class="row g-3 align-items-end">

                <div class="col-md-5">

                    <label class="filter-label">
                        Doctor Name
                    </label>

                    <input type="text"
                           name="doctorName"
                           value="@ViewBag.DoctorName"
                           class="form-control search-input"
                           placeholder="Search by doctor name..." />

                </div>


                <div class="col-md-5">

                    <label class="filter-label">
                        Specialization
                    </label>

                    <select name="specialization"
                            class="form-select search-input">

                        <option value="">All Specializations</option>

                        @foreach (var item in ViewBag.Specializations)
                        {
                            <option value="@item"
                                    selected="@(ViewBag.Specialization == item)">
                                @item
                            </option>
                        }

                    </select>

                </div>


                <div class="col-md-2">

                    <button type="submit"
                            class="search-btn w-100">
                        Search
                    </button>

                </div>

            </form>

        </div>


        <!-- Doctors Cards -->
        <div class="row g-4">

            @foreach (var doctor in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="doctor-card">

                        <!-- Doctor Image -->
                        <div class="doctor-image-container">

                            <img src="~/images/doctors/@doctor.Image"
                                 alt="Dr. @doctor.Name"
                                 class="doctor-image" />

                            <div class="doctor-badge">
                                Available
                            </div>

                        </div>


                        <!-- Doctor Information -->
                        <div class="doctor-info">

                            <span class="doctor-title">
                                MEDICAL SPECIALIST
                            </span>

                            <h3>
                                Dr. @doctor.Name
                            </h3>

                            <p class="doctor-specialization">
                                @doctor.Specialization
                            </p>


                            <div class="doctor-line"></div>


                            <a asp-controller="Appointments"
                               asp-action="Book"
                               asp-route-doctorId="@doctor.Id"
                               class="book-btn">

                                Book Appointment

                                <span>→</span>

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>


        <!-- No Doctors -->
        @if (Model.Count == 0)
        {
            <div class="no-doctors">

                <h3>No Doctors Found</h3>

                <p>
                    Try searching with a different name or specialization.
                </p>

            </div>
        }


        <!-- Pagination -->
        <div class="pagination-area">

            @if (ViewBag.CurrentPage > 1)
            {
                <a class="page-btn"
                   asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage - 1)"
                   asp-route-doctorName="@ViewBag.DoctorName"
                   asp-route-specialization="@ViewBag.Specialization">

                    ← Previous

                </a>
            }


            <div class="page-number">

                Page
                <strong>@ViewBag.CurrentPage</strong>
                of
                <strong>@ViewBag.TotalPages</strong>

            </div>


            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <a class="page-btn"
                   asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage + 1)"
                   asp-route-doctorName="@ViewBag.DoctorName"
                   asp-route-specialization="@ViewBag.Specialization">

                    Next →

                </a>
            }

        </div>

    </div>

</div>
```
